<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<FleckDef ParentName="FleckBase">
		<defName>VGE_AstrofireBlast</defName>
		<graphicData>
			<texPath>Effects/AstrofireBlast</texPath>
			<shaderType>TransparentPostLight</shaderType>
			<renderInstanced>true</renderInstanced>
		</graphicData>
		<altitudeLayer>MoteOverhead</altitudeLayer>
		<solidTime>0</solidTime>
		<fadeOutTime>0.2</fadeOutTime>
	</FleckDef>
	<FleckDef ParentName="FleckBase_Thrown">
		<defName>VGE_MaintenanceSmoke</defName>
		<graphicData>
			<texPath>Things/Mote/Smoke</texPath>
			<renderInstanced>true</renderInstanced>
			<color>(0.15,0.15,0.16,0.3)</color>
			<drawSize>(1.5, 1.5)</drawSize>
		</graphicData>
		<altitudeLayer>MoteOverhead</altitudeLayer>
		<fadeInTime>0.5</fadeInTime>
		<solidTime>0.5</solidTime>
		<fadeOutTime>16.2</fadeOutTime>
		<growthRate>0.04</growthRate>
		<acceleration>(0.05, 0.0, 0.0)</acceleration>
	</FleckDef>
	<FleckDef ParentName="FleckBase_Thrown">
		<defName>VGE_JavelinGlow</defName>
		<graphicData>
			<texPath>Things/Mote/FireGlow</texPath>
			<shaderType>MoteGlow</shaderType>
		</graphicData>
		<altitudeLayer>MoteOverhead</altitudeLayer>
		<fadeInTime>0.1</fadeInTime>
		<solidTime>0</solidTime>
		<fadeOutTime>1.5</fadeOutTime>
	</FleckDef>
	<FleckDef ParentName="FleckGlowDistortBackground">
		<defName>VGE_GaussDistortion</defName>
		<altitudeLayer>MoteLow</altitudeLayer>
		<fadeInTime>0.02</fadeInTime>
		<fadeOutTime>0.04</fadeOutTime>
		<solidTime>0</solidTime>
		<growthRate>1.2</growthRate>
		<graphicData>
			<texPath>Things/Mote/Black</texPath>
			<shaderParameters>
				<_distortionIntensity>0.01</_distortionIntensity>
				<_brightnessMultiplier>1.15</_brightnessMultiplier>
			</shaderParameters>
			<drawSize>2.3</drawSize>
		</graphicData>
	</FleckDef>

  <FleckDef ParentName="FleckBase_Thrown">
    <defName>VGE_GaussImpact</defName>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fleckSystemClass>FleckSystemThrown</fleckSystemClass>
    <fadeInTime>0.05</fadeInTime>
    <fadeOutTime>0.2</fadeOutTime>
    <solidTime>0.1</solidTime>
    <growthRate>2</growthRate>
    <graphicData>
      <texPath>Things/Mote/VaporizeExplosionGlow</texPath>
      <shaderType>MoteGlow</shaderType>
      <drawSize>(4.5, 4.5)</drawSize>
    </graphicData>
  </FleckDef>


  <FleckDef ParentName="FleckBase">
    <defName>VGE_HazeFleck</defName>
    <altitudeLayer>MoteOverheadLow</altitudeLayer>
    <fadeInTime>0</fadeInTime>
    <solidTime>0.5</solidTime>
    <fadeOutTime>0</fadeOutTime>
    <graphicData>
      <texPath>Things/Mote/Black</texPath>
      <shaderType>VGE_Haze</shaderType>
      <shaderParameters>
        <_NoiseTexA>/Effects/Haze/HazeNoiseA</_NoiseTexA>
        <_NoiseTexB>/Effects/Haze/HazeNoiseB</_NoiseTexB>
        <_NoiseScaleA>0.171</_NoiseScaleA>
        <_NoiseScaleB>0.075</_NoiseScaleB>
        <_NoiseSpeedA>(0.08, 0.03, 0, 0)</_NoiseSpeedA>
        <_NoiseSpeedB>(-0.02, 0.03, 0, 0)</_NoiseSpeedB>
        <_DistortionIntensity>0.035</_DistortionIntensity>
        <_RippleIntensity>1</_RippleIntensity>
        <_HazeIntensity>0.4</_HazeIntensity>
        <_BrightnessMultiplier>1.0</_BrightnessMultiplier>
        <_EdgeFadePower>1.8</_EdgeFadePower>
      </shaderParameters>
      <drawSize>(1, 1)</drawSize>
    </graphicData>
  </FleckDef>
</Defs>
