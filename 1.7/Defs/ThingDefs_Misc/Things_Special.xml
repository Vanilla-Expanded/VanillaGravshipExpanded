<?xml version="1.0" encoding="utf-8" ?>
<Defs>

 
  <VEF.Things.CustomFireDef>
    <defName>VGE_Astrofire</defName>
    <label>astrofire</label>
    <thingClass>VEF.Things.CustomFire</thingClass>
    <category>Attachment</category>
    <tickerType>Normal</tickerType>
    <forceDebugSpawnable>true</forceDebugSpawnable>
    <graphicData>
      <texPath>Effects/Astrofire</texPath>
      <graphicClass>VEF.Things.Graphic_CustomFireFlicker</graphicClass>
      <shaderType>TransparentPostLight</shaderType>
    </graphicData> 
    <altitudeLayer>PawnState</altitudeLayer>
    <useHitPoints>false</useHitPoints>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>4</glowRadius>
        <glowColor>(146,76,237)</glowColor>
      </li>
    </comps>
    
    <!-- CustomFireDef properties -->
    <spreadIntervalTicksBase>300</spreadIntervalTicksBase>
    <minTicksBetweenFireSpread>150</minTicksBetweenFireSpread>
    <replacesFire>true</replacesFire>
    <vacuumExtinguishDamage>0</vacuumExtinguishDamage>
    <vacuumExtinguishDamageChance>0</vacuumExtinguishDamageChance>
    <vacuumAffectsFireSizeGrowth>false</vacuumAffectsFireSizeGrowth>

    <!-- Replacement defs -->
    <sparkDef>VGE_AstrofireSpark</sparkDef>
    <fireDamageDef>VGE_AstrofireDamage</fireDamageDef>
    <extinguishDamageDef>VGE_ExtinguishAstrofire</extinguishDamageDef>

    <!-- Default JobDef report string overrides -->
    <translationKeyReportBeatFire>VGE_ReportBeatAstrofire</translationKeyReportBeatFire>
    <translationKeyReportExtinguishFiresNearby>VGE_ReportExtinguishAstrofiresNearby</translationKeyReportExtinguishFiresNearby>
  </VEF.Things.CustomFireDef>
  
  <ThingDef>
    <defName>VGE_AstrofireSpark</defName>
    <label>astrofire spark</label>
    <category>Projectile</category>
    <thingClass>VEF.Things.CustomFireSpark</thingClass>
    <graphicData>
      <texPath>Effects/Astrospark</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Transparent</shaderType>
    </graphicData>
    <tickerType>Normal</tickerType>
    <altitudeLayer>Projectile</altitudeLayer>
    <useHitPoints>false</useHitPoints>
    <neverMultiSelect>true</neverMultiSelect>
    <projectile>
      <alwaysFreeIntercept>true</alwaysFreeIntercept>
      <speed>1.5</speed>
    </projectile>
  </ThingDef>

   <ThingDef ParentName="EtherealThingBase">
    <defName>VGE_LandingStructure</defName>
    <label>landing structure</label>
    <thingClass>VanillaGravshipExpanded.LandingStructure</thingClass>
    <category>Ethereal</category>
    <useHitPoints>false</useHitPoints>
    <drawOffscreen>true</drawOffscreen>
    <tickerType>Normal</tickerType>
    <altitudeLayer>Skyfaller</altitudeLayer>
    <drawerType>RealtimeOnly</drawerType>
  </ThingDef>

</Defs>
