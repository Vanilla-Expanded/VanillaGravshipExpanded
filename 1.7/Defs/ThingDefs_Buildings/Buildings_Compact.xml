<Defs>
	<ThingDef ParentName="BuildingBase">
		<defName>VGE_CompactStove</defName>
		<label>compact stove</label>
		<description>A space-efficient, gravship-powered stove designed for use aboard gravships. Despite its smaller frame, it contains a high-efficiency cooktop and integrated prep surface, as well as a butchering slate. It draws power directly from the grav engine.</description>
		<thingClass>Building_WorkTable_HeatPush</thingClass>
		<interactionCellIcon>DiningChair</interactionCellIcon>
		<noRightClickDraftAttack>true</noRightClickDraftAttack>
		<graphicData>
			<texPath>Things/Structures/Production/GravshipCookingStove</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(2,1)</drawSize>
			<damageData>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
			</damageData>
		</graphicData>
		<castEdgeShadows>true</castEdgeShadows>
		<staticSunShadowHeight>0.20</staticSunShadowHeight>
		<constructEffect>ConstructMetal</constructEffect>
		<minifiedDef>MinifiedThing</minifiedDef>
		<costList>
			<Steel>60</Steel>
			<ComponentIndustrial>2</ComponentIndustrial>
			<GravlitePanel>6</GravlitePanel>
		</costList>
		<thingCategories>
			<li>BuildingsProduction</li>
		</thingCategories>
		<altitudeLayer>Building</altitudeLayer>
		<fillPercent>0.3</fillPercent>
		<useHitPoints>True</useHitPoints>
		<statBases>
			<WorkToBuild>2200</WorkToBuild>
			<MaxHitPoints>160</MaxHitPoints>
			<Flammability>1.0</Flammability>
			<Mass>15</Mass>
		</statBases>
		<size>(2,1)</size>
		<designationCategory>Odyssey</designationCategory>
		<passability>PassThroughOnly</passability>
		<pathCost>40</pathCost>
		<hasInteractionCell>True</hasInteractionCell>
		<interactionCellOffset>(1,0,-1)</interactionCellOffset>
		<surfaceType>Item</surfaceType>
		<constructionSkillPrerequisite>4</constructionSkillPrerequisite>
		<terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
		<inspectorTabs>
			<li>ITab_Bills</li>
		</inspectorTabs>
		<comps>
			<li Class="CompProperties_Breakdownable"/>
			<li Class="CompProperties_HeatPusher">
				<compClass>CompHeatPusherPowered</compClass>
				<heatPerSecond>2.5</heatPerSecond>
			</li>
			<li Class="CompProperties_AffectedByFacilities">
				<linkableFacilities>
          <!-- We automatically copy all butcher table and electric stove facilities using AffectedByFacilitiesExtension. -->
        </linkableFacilities>
			</li>
		</comps>
		<building>
			<isMealSource>true</isMealSource>
			<spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
			<heatPerTickWhileWorking>0.10</heatPerTickWhileWorking>
			<relatedTerrain>
				<li>Substructure</li>
			</relatedTerrain>
			<buildingTags>
				<li>Production</li>
			</buildingTags>
		</building>
		<designationHotKey>Misc8</designationHotKey>
		<placeWorkers>
			<li>PlaceWorker_ShowFacilitiesConnections</li>
			<li>PlaceWorker_PreventInteractionSpotOverlap</li>
			<li>PlaceWorker_ReportWorkSpeedPenalties</li>
		</placeWorkers>
		<researchPrerequisites>
			<li>VGE_GravshipLiving</li>
		</researchPrerequisites>
		<modExtensions>
			<li Class="VEF.Buildings.RecipeInheritanceExtension">
				<inheritRecipesFrom>
					<li>FueledStove</li>
					<li>TableButcher</li>
				</inheritRecipesFrom>
			</li>
