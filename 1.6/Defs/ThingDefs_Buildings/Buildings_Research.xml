<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingDef ParentName="GravshipComponentBase">
		<defName>VGE_GravtechConsole</defName>
		<label>gravtech console</label>
		<description>An interface used to analyze gravdata gathered from gravship launches and travel. In orbit, gravtech researcher can work the console to generate a continuous stream of gravdata. It draws power directly from the grav engine.</description>
		<graphicData>
			<graphicClass>Graphic_Multi</graphicClass>
			<texPath>Things/Structures/GravtechResearchBench/GravtechResearchBench</texPath>
			<drawSize>(4,2)</drawSize>
		</graphicData>
		<costList>
			<Steel>100</Steel>
			<ComponentIndustrial>6</ComponentIndustrial>
		</costList>
		<fillPercent>0.3</fillPercent>
		<statBases>
			<WorkToBuild>3000</WorkToBuild>
			<MaxHitPoints>250</MaxHitPoints>
			<Flammability>0.5</Flammability>
			<Beauty>-4</Beauty>
			<Mass>10</Mass>
			<VGE_MaintenanceSensitivity>2</VGE_MaintenanceSensitivity>
		</statBases>
		<size>(3,1)</size>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<pathCost>50</pathCost>
		<tickerType>Normal</tickerType>
		<comps>
			<li Class="CompProperties_GravshipFacility">
				<compClass>VanillaGravshipExpanded.CompGravtechConsole</compClass>
				<maxSimultaneous>1</maxSimultaneous>
				<maxDistance>200</maxDistance>
				<requiresLOS>false</requiresLOS>
			</li>
			<li Class="VanillaGravshipExpanded.CompProperties_GravdataYield">
				<multiplier>5</multiplier>
			</li>
			<li Class="CompProperties_Breakdownable"/>
			<li Class="VanillaGravshipExpanded.CompProperties_GravMaintainable">

            </li>
		</comps>
		<placeWorkers>
			<li>PlaceWorker_PreventInteractionSpotOverlap</li>
		</placeWorkers>
		<researchPrerequisites>
			<li>StandardGravtech</li>
		</researchPrerequisites>
		<rotatable>true</rotatable>
		<canOverlapZones>false</canOverlapZones>
		<resourcesFractionWhenDeconstructed>1</resourcesFractionWhenDeconstructed>
		<constructionSkillPrerequisite>5</constructionSkillPrerequisite>
		<designationCategory>Odyssey</designationCategory>
		<hasInteractionCell>true</hasInteractionCell>
		<interactionCellOffset>(0, 0,-1)</interactionCellOffset>
		<terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
		<uiOrder>2350</uiOrder>
	</ThingDef>

	<ThingDef ParentName="GravshipComponentBase">
		<defName>VGE_GravshipBlackBox</defName>
		<label>gravship black box</label>
		<description>An indestructible advanced recorder integrated into the gravship’s systems. It greatly increases gravdata yield, captures any overflow that would normally be wasted, and allows stored gravdata to be converted directly into research points. A gravship can support only one black box.</description>
		<thingClass>VanillaGravshipExpanded.Building_GravshipBlackBox</thingClass>
		<graphicData>
			<graphicClass>Graphic_Multi</graphicClass>
			<texPath>Things/Structures/GravshipBlackBox/GravshipBlackBox</texPath>
			<drawSize>(2,1)</drawSize>
		</graphicData>
		<costList>
			<GravlitePanel>80</GravlitePanel>
			<ComponentIndustrial>4</ComponentIndustrial>
			<ComponentSpacer>8</ComponentSpacer>
		</costList>
		<useHitPoints>false</useHitPoints>
		<statBases>
			<Flammability>0</Flammability>
			<Beauty>-10</Beauty>
			<Mass>15</Mass>
		</statBases>
		<pathCost>20</pathCost>
		<size>(2,1)</size>
		<passability>PassThroughOnly</passability>
		<rotatable>true</rotatable>
		<fillPercent>0.4</fillPercent>
		<canOverlapZones>false</canOverlapZones>
		<terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
		<comps>
			<li Class="CompProperties_GravshipFacility">
				<requiresLOS>false</requiresLOS>
				<maxSimultaneous>1</maxSimultaneous>
				<maxDistance>500</maxDistance>
			</li>
			<li Class="VanillaGravshipExpanded.CompProperties_GravdataYield">
				<multiplier>2.0</multiplier>
			</li>
			<li Class="CompProperties_Breakdownable"/>
		</comps>
		<tradeTags>
			<li>GravshipUpgrade</li>
		</tradeTags>
	</ThingDef>

	<ThingDef ParentName="GravshipComponentBase">
		<defName>VGE_FlightComputer</defName>
		<label>flight computer</label>
		<description>An advanced computational unit that optimizes data collection during gravship travel. Increases the amount of gravdata gained from each launch.</description>
		<graphicData>
			<graphicClass>Graphic_Multi</graphicClass>
			<texPath>Things/Structures/FlightComputer/FlightComputer</texPath>
			<drawSize>(3,2)</drawSize>
		</graphicData>
		<costList>
			<Steel>40</Steel>
			<GravlitePanel>20</GravlitePanel>
			<ComponentIndustrial>2</ComponentIndustrial>
			<ComponentSpacer>6</ComponentSpacer>
		</costList>
		<tickerType>Normal</tickerType>
		<statBases>
			<Flammability>0.4</Flammability>
			<Beauty>-5</Beauty>
			<Mass>20</Mass>
			<MaxHitPoints>120</MaxHitPoints>
			<VGE_MaintenanceSensitivity>3</VGE_MaintenanceSensitivity>
		</statBases>
		<pathCost>20</pathCost>
		<size>(2,1)</size>
		<passability>PassThroughOnly</passability>
		<rotatable>true</rotatable>
		<fillPercent>0.4</fillPercent>
		<canOverlapZones>false</canOverlapZones>
		<terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
		<comps>
			<li Class="CompProperties_GravshipFacility">
				<requiresLOS>false</requiresLOS>
				<maxSimultaneous>2</maxSimultaneous>
				<maxDistance>500</maxDistance>
			</li>
			<li Class="VanillaGravshipExpanded.CompProperties_GravdataYield">
				<offset>1</offset>
			</li>
			<li Class="CompProperties_Breakdownable"/>
			<li Class="VanillaGravshipExpanded.CompProperties_GravMaintainable"></li>
		</comps>
		<tradeTags>
			<li>GravshipUpgrade</li>
		</tradeTags>
	</ThingDef>

  <ThingDef ParentName="BenchBase">
    <defName>VGE_CompactResearchBench</defName>
    <label>compact research bench</label>
    <description>A miniaturized version of the high-tech research bench, designed to fit within the confined spaces of a gravship. Despite its compact size, it features the same computers and electronic equipment, providing the same research capabilities and unlocking advanced projects as its larger counterpart. It draws power directly from the grav engine.</description>
    <thingClass>Building_ResearchBench</thingClass>
    <size>(3,1)</size>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>150</costStuffCount>
    <costList>
      <GravlitePanel>20</GravlitePanel>
      <Steel>200</Steel>
      <ComponentIndustrial>10</ComponentIndustrial>
    </costList>
    <graphicData>
      <texPath>Things/Structures/GravshipFurniture/GravshipHiTechResearchBench/GravshipHiTechResearchBench</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3,1)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.20</staticSunShadowHeight>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToBuild>5000</WorkToBuild>
      <Flammability>1.0</Flammability>
      <ResearchSpeedFactor>1.0</ResearchSpeedFactor>
    </statBases>
    <comps Inherit="False">
      <li Class="CompProperties_ReportWorkSpeed">
        <workSpeedStat>ResearchSpeedFactor</workSpeedStat>
      </li>
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <!-- We're copying all facilities from hi-tech research bench. -->
        </linkableFacilities>
      </li>
    </comps>
    <fillPercent>0.5</fillPercent>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <hasInteractionCell>true</hasInteractionCell>
    <terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
    <designationCategory>Odyssey</designationCategory>
    <uiOrder>2348</uiOrder>
    <surfaceType>Item</surfaceType>
    <designationHotKey>Misc4</designationHotKey>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
      <li>PlaceWorker_DrawLinesToBookcasesInRoom</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>MicroelectronicsBasics</li>
      <li>VGE_CompactWorkspaces</li>
    </researchPrerequisites>
    <building>
      <paintable>true</paintable>
      <workTableRoomRole>Laboratory</workTableRoomRole>
      <workTableNotInRoomRoleFactor>0.8</workTableNotInRoomRoleFactor>
    </building>
    <modExtensions>
      <li Class="VEF.Buildings.AffectedByFacilitiesExtension">
        <copyLinksFrom>
          <li>HiTechResearchBench</li>
        </copyLinksFrom>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>VGE_CompactMultiAnalyzer</defName>
    <label>compact multi-analyzer</label>
    <description>A miniaturized version of the multi-analyzer, designed to work aboard a gravship. While taking up less space, it performs the same essential function: increasing research speed when placed near a high-tech research bench and unlocking advanced projects. Each bench can only benefit from one multi-analyzer. It draws power directly from the grav engine.</description>
    <graphicData>
      <texPath>Things/Structures/GravshipFurniture/GravshipMultianalyzer/GravshipMultianalyzer</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <uiIconScale>0.85</uiIconScale>
    <researchPrerequisites>
      <li>MultiAnalyzer</li>
      <li>VGE_CompactWorkspaces</li>
    </researchPrerequisites>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <castEdgeShadows>true</castEdgeShadows>
    <fillPercent>0.5</fillPercent>
    <designationHotKey>Misc4</designationHotKey>
    <designationCategory>Odyssey</designationCategory>
    <uiOrder>2349</uiOrder>
    <minifiedDef>MinifiedThing</minifiedDef>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
    <thingCategories>
      <li>BuildingsMisc</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToBuild>7500</WorkToBuild>
      <Mass>30</Mass>
      <Flammability>1.0</Flammability>
    </statBases>
    <costList>
      <GravlitePanel>10</GravlitePanel>
      <Plasteel>40</Plasteel>
      <Gold>10</Gold>
      <ComponentIndustrial>6</ComponentIndustrial>
    </costList>
    <building>
      <destroySound>BuildingDestroyed_Metal_Medium</destroySound>
    </building>
    <comps>
      <li Class="CompProperties_Facility">
        <statOffsets>
          <ResearchSpeedFactor>0.1</ResearchSpeedFactor>
        </statOffsets>
        <maxSimultaneous>1</maxSimultaneous>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <modExtensions>
      <li Class="VEF.Buildings.FacilityExtension">
        <equivalentToFacility>MultiAnalyzer</equivalentToFacility>
        <copyLinksFrom>
          <li>MultiAnalyzer</li>
        </copyLinksFrom>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>