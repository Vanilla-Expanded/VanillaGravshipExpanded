<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<ThingDef ParentName="GravshipComponentBase">
		<defName>VGE_OperatorSubpersonaCore</defName>
		<label>operator subpersona core</label>
		<description>A high-grade subcore specialized in gravship combat. It can link with a single gravship artillery piece and control it the same way a crewmember manning a targeting terminal can. It’s combat capabilities are subpar, but it allows for autonomous artillery batteries without the need for human operators.</description>
		<thingClass>VanillaGravshipExpanded.Building_AutonomousTargeting</thingClass>
		<tickerType>Normal</tickerType>
		<graphicData>
			<texPath>Things/Structures/Biotech/OperatorSubcore</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1, 1)</drawSize>
		</graphicData>
		<statBases>
			<WorkToBuild>1600</WorkToBuild>
			<MaxHitPoints>80</MaxHitPoints>
			<Flammability>0.7</Flammability>
			<Beauty>0</Beauty>
			<Mass>25</Mass>
		</statBases>
		<size>(1,1)</size>
		<rotatable>false</rotatable>
		<pathCost>20</pathCost>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.4</fillPercent>
		<terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
		<designationCategory>VGE_Combat</designationCategory>
		<constructionSkillPrerequisite>8</constructionSkillPrerequisite>
		<constructEffect>ConstructMetal</constructEffect>
		<researchPrerequisites>
			<li>VGE_GravshipWeaponry</li>
			<li>HighMechtech</li>
		</researchPrerequisites>
		<costList>
			<Steel>60</Steel>
			<GravlitePanel>20</GravlitePanel>
			<SubcoreHigh>1</SubcoreHigh>
		</costList>
		<comps>
			<li Class="CompProperties_GravshipFacility">
				<requiresLOS>false</requiresLOS>
				<maxSimultaneous>1</maxSimultaneous>
				<maxDistance>500</maxDistance>
			</li>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>100</basePowerConsumption>
			</li>
		</comps>
		<tradeTags>
			<li>GravshipUpgrade</li>
		</tradeTags>
		<modExtensions>
			<li Class="VanillaGravshipExpanded.AutonomousTargetingExtension">
				<gravshipTargeting>0.9</gravshipTargeting>
			</li>
		</modExtensions>
		<uiOrder>2005</uiOrder>
	</ThingDef>
	<ThingDef Name="VGE_CompactGeneBuildingBase" ParentName="BuildingBase" Abstract="True">
		<researchPrerequisites>
			<li>Xenogermination</li>
			<li>VGE_CompactWorkspaces</li>
		</researchPrerequisites>
		<altitudeLayer>Building</altitudeLayer>
		<pathCost>42</pathCost>
		<building>
			<ai_chillDestination>false</ai_chillDestination>
			<relatedTerrain>
				<li>Substructure</li>
			</relatedTerrain>
			<buildingTags>
				<li>Biotech</li>
			</buildingTags>
			<workTableRoomRole>Laboratory</workTableRoomRole>
		</building>
		<placeWorkers>
			<li>PlaceWorker_ShowFacilitiesConnections</li>
		</placeWorkers>
		<terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
		<drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
		<constructEffect>ConstructMetal</constructEffect>
		<designationCategory>Odyssey</designationCategory>
		<comps>
			<li Class="CompProperties_Forbiddable"/>
		</comps>
	</ThingDef>
	<ThingDef ParentName="VGE_CompactGeneBuildingBase">
		<defName>VGE_CompactGeneBank</defName>
		<label>compact gene bank</label>
		<description>text.todo</description>
		<graphicData>
			<texPath>Things/Structures/Biotech/GravshipGenebank/GravshipGenebank</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(2, 2)</drawSize>
		</graphicData>
		<castEdgeShadows>true</castEdgeShadows>
		<staticSunShadowHeight>0.20</staticSunShadowHeight>
		<minifiedDef>MinifiedThing</minifiedDef>
		<tickerType>Rare</tickerType>
		<passability>PassThroughOnly</passability>
		<canOverlapZones>false</canOverlapZones>
		<fillPercent>0.4</fillPercent>
		<pathCost>40</pathCost>
		<size>(1, 1)</size>
		<statBases>
			<MaxHitPoints>200</MaxHitPoints>
			<WorkToBuild>5000</WorkToBuild>
			<Mass>20</Mass>
			<Flammability>0.5</Flammability>
		</statBases>
		<thingCategories>
			<li>BuildingsProduction</li>
		</thingCategories>
		<inspectorTabs>
			<li>ITab_ContentsGenepackHolder</li>
		</inspectorTabs>
		<costList>
			<Steel>50</Steel>
			<ComponentIndustrial>1</ComponentIndustrial>
			<GravlitePanel>2</GravlitePanel>
		</costList>
		<constructionSkillPrerequisite>4</constructionSkillPrerequisite>
		<descriptionHyperlinks>
			<ThingDef>Genepack</ThingDef>
			<ThingDef>GeneAssembler</ThingDef>
		</descriptionHyperlinks>
		<comps>
			<li Class="CompProperties_GenepackContainer">
				<maxCapacity>4</maxCapacity>
			</li>
			<li Class="CompProperties_Facility">
				<maxSimultaneous>100</maxSimultaneous>
				<maxDistance>12.9</maxDistance>
				<showMaxSimultaneous>false</showMaxSimultaneous>
			</li>
			<li Class="CompProperties_Flickable"/>
		</comps>
	</ThingDef>
</Defs>